{
  "name": "@input/pen-docs",
  "private": true,
  "version": "0.0.1",
  "description": "Repository documentation site for Pen",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./scripts/check-doc2-pages.mjs && node ./scripts/check-collaboration-contract.mjs && node ./scripts/generate-doc-tables.mjs && node ./scripts/check-doc2-samples.mjs && vite build",
    "preview": "vite preview",
    "check:pages": "node ./scripts/check-doc2-pages.mjs",
    "check:collaboration": "node ./scripts/check-collaboration-contract.mjs",
    "check:tables": "node ./scripts/generate-doc-tables.mjs",
    "check:samples": "node ./scripts/check-doc2-samples.mjs",
    "generate:tables": "node ./scripts/generate-doc-tables.mjs --write",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
