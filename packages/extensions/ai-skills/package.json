{
  "name": "@input/pen-ai-skills",
  "version": "0.0.1",
  "description": "Agent skill artifacts for Pen AI tools",
  "license": "MIT",
  "homepage": "https://github.com/lemni/pen#readme",
  "bugs": {
    "url": "https://github.com/lemni/pen/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lemni/pen.git",
    "directory": "packages/extensions/ai-skills"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config ./vitest.config.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@input/pen-ai-autocomplete": "workspace:^",
    "@input/pen-ai-tools": "workspace:^"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
