{
  "name": "@input/pen-vue",
  "version": "0.0.1",
  "description": "Vue rendering primitives for Pen",
  "license": "MIT",
  "homepage": "https://github.com/lemni/pen#readme",
  "bugs": {
    "url": "https://github.com/lemni/pen/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lemni/pen.git",
    "directory": "packages/rendering/vue"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.mjs"
      },
      "require": {
        "types": "./dist/plugin.d.cts",
        "default": "./dist/plugin.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "STYLING.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm --filter @input/pen-preset-default build && vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@input/pen-core": "workspace:^",
    "@input/pen-dom": "workspace:^",
    "@input/pen-interop": "workspace:^",
    "@input/pen-schema-default": "workspace:^",
    "@input/pen-types": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@input/pen-preset-default": "workspace:*",
    "@input/pen-test": "workspace:*",
    "@input/pen-undo": "workspace:*",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^28.1.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "vue": "^3.5.30"
  }
}
