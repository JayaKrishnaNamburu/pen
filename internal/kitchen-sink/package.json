{
  "name": "@input/pen-kitchen-sink",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "tsx watch --clear-screen=false --exclude \"../../packages/**/dist/**\" --tsconfig tsconfig.server.json server/index.ts",
    "dev:e2e": "PEN_E2E=1 vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@input/pen-ai": "workspace:*",
    "@input/pen-assets-memory": "workspace:^",
    "@input/pen-core": "workspace:*",
    "@input/pen-crdt-yjs": "workspace:^",
    "@input/pen-interop": "workspace:*",
    "@input/pen-input-rules": "workspace:*",
    "@input/pen-multiplayer": "workspace:^",
    "@input/pen-preset-default": "workspace:*",
    "@input/pen-react": "workspace:*",
    "@input/pen-schema-default": "workspace:*",
    "@input/pen-search": "workspace:*",
    "@input/pen-shortcuts": "workspace:*",
    "@input/pen-types": "workspace:*",
    "@y/websocket-server": "^0.1.5",
    "ai": "^6.0.116",
    "dotenv": "^17.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.19.0",
    "y-websocket": "^3.0.0",
    "yjs": "13.6.29"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
