{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

  // Leaf workspace dirs only. `packages/**` also matches grouping folders
  // (packages/crdt, packages/extensions, …) that have no package.json.
  "workspaces": {
    "patterns": [
      "packages/core",
      "packages/types",
      "packages/docs",
      "packages/crdt/yjs",
      "packages/schema/default",
      "packages/presets/default",
      "packages/extensions/*",
      "packages/rendering/*",
      "packages/shared/*",
      "packages/transports/*",
      "packages/tooling/*",
      "examples/*",
      "playground"
    ]
  },

  // Compile-time type pin: included by tsconfig, never imported.
  "dynamicallyLoaded": [
    "packages/tooling/conformance/src/mirrors/pin.ts"
  ],

  // CLI / Vite / CI files that are executed, not imported.
  "entry": [
    "scripts/*.mjs",
    "packages/docs/scripts/*.mjs",
    "packages/tooling/conformance/harness/src/main.tsx",
    "packages/tooling/conformance/harness/src/App.tsx",
    "packages/tooling/conformance/vitest.nightly.ts",
    "packages/tooling/conformance/src/lints/*.mjs",
    "packages/tooling/bench/src/soak/*.{mjs,cjs}",
    "packages/crdt/yjs/src/__tests__/fixtures/yjs-duplicate/build.mjs",
    "packages/rendering/react/fixtures/rsc/assert-client-boundary.mjs",
    "packages/tooling/test/src/fixtures/durability/*.mjs"
  ],

  "ignorePatterns": [
    "**/*.generated.ts",
    "packages/docs/src/generated/**",
    "scripts/__fixtures__/**",
    "**/test-results*/**"
  ],

  // Published SDK surface. Do not treat package entry exports as unused.
  "publicPackages": [
    "@input/pen-ai",
    "@input/pen-assets-memory",
    "@input/pen-bench",
    "@input/pen-content-ops",
    "@input/pen-core",
    "@input/pen-crdt-yjs",
    "@input/pen-document-ops",
    "@input/pen-dom",
    "@input/pen-history",
    "@input/pen-input-rules",
    "@input/pen-interop",
    "@input/pen-markdown-serialization",
    "@input/pen-multiplayer",
    "@input/pen-preset-default",
    "@input/pen-react",
    "@input/pen-schema-default",
    "@input/pen-search",
    "@input/pen-shortcuts",
    "@input/pen-test",
    "@input/pen-transport-direct",
    "@input/pen-transport-sse",
    "@input/pen-types",
    "@input/pen-undo",
    "@input/pen-vue"
  ],

  // Keep same-file-only `export` visible. Those are leftovers from splits,
  // not public API. The commit gate is new-only, so the existing backlog
  // does not fail the hook.
  "ignoreExportsUsedInFile": false,

  "ignoreExports": [
    {
      "file": "packages/rendering/dom/src/utils/clipboardIngest.ts",
      "exports": ["CLIPBOARD_INGEST_TIME_BUDGET_MS"]
    },
    {
      "file": "packages/extensions/interop/src/xml/ingestBounds.ts",
      "exports": ["INGEST_TIME_BUDGET_MS"]
    }
  ],

  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unlisted-dependencies": "error",
    "unresolved-imports": "error",
    // Editor / FieldEditor methods are the host API. Syntactic unused ≠ unused.
    "unused-class-members": "off",
    // docs + conformance list workspace packages for generation / harness assembly.
    "unused-dev-dependencies": "warn",
    "circular-dependencies": "warn",
    "duplicate-exports": "warn"
  },

  "duplicates": {
    "mode": "mild",
    "minOccurrences": 3
  },

  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/__tests__/**",
        "**/suites/**",
        "**/harness/**"
      ],
      "rules": {
        "unused-exports": "off",
        "unused-types": "off"
      }
    },
    {
      "files": [
        "packages/docs/package.json",
        "packages/tooling/conformance/package.json"
      ],
      "rules": {
        "unused-dev-dependencies": "off"
      }
    }
  ]
}
